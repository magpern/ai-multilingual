                                        "tabs": [
                                            {
                                                "_id": "ca4722d4",
                                                "tab_title": "What does lyophilized mean?",
                                                "tab_content": "<p style=\"margin:0 0 14px;font-size:16px;line-height:1.55;color:#3D4F66\">Lyophilized means freeze-dried. Moisture is removed from a frozen material under controlled conditions, producing a dry powder or solid commonly used for research inventory and transport.</p>"
                                            },
                                            {
                                                "_id": "bf34136c",
                                                "tab_title": "Why are research materials freeze-dried?",
                                                "tab_content": "<p style=\"margin:0 0 14px;font-size:16px;line-height:1.55;color:#3D4F66\">Freeze-drying is widely used to reduce moisture content and support handling workflows in research supply chains. Laboratories often prefer dry formats for storage organization and transport stability when appropriate packaging is used.</p>"
                                            },
                                            {
                                                "_id": "5832fc5a",
                                                "tab_title": "How should lyophilized materials be stored?",
                                                "tab_content": "<p style=\"margin:0 0 14px;font-size:16px;line-height:1.55;color:#3D4F66\">Store cool and dry, protect from unnecessary light exposure, and follow institutional protocols plus any labeling supplied with the material. See Storage &amp; Handling for general BioPentra guidance.</p>"
                                            },
                                            {
                                                "_id": "92fff08e",
                                                "tab_title": "Why are products available in multiple strengths?",
                                                "tab_content": "<p style=\"margin:0 0 14px;font-size:16px;line-height:1.55;color:#3D4F66\">Multiple strengths let researchers order a catalog variation suited to an experimental plan. Available options are shown on each product page where variations exist.</p>"
                                            },
                                            {
                                                "_id": "80625cad",
                                                "tab_title": "Are lyophilized products intended for human use?",
                                                "tab_content": "<p style=\"margin:0 0 14px;font-size:16px;line-height:1.55;color:#3D4F66\">No. BioPentra materials are for laboratory research use only and are not intended for human or veterinary consumption, diagnosis, or treatment.</p>"
                                            },
                                            {
                                                "_id": "3820c109",
                                                "tab_title": "Why are some materials supplied in powder form?",
                                                "tab_content": "<p style=\"margin:0 0 14px;font-size:16px;line-height:1.55;color:#3D4F66\">Powder or cake form is the typical appearance of lyophilized material after freeze-drying. The dry presentation is a supply format for research handling and storage, not a statement about application outside the laboratory.</p>"
                                            }
