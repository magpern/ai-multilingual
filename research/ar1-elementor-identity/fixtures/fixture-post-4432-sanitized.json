                                    "widgetType": "text-editor",
                                    "settings": {
                                        "editor": "<p style=\"margin:0 0 14px;font-size:16px;line-height:1.55;color:#3D4F66\">Kisspeptin is cataloged as a lyophilized research peptide for laboratory reference. Visit <a href=\"https://www.biopentra.eu/product/kisspeptin/\" style=\"color:#1F5FAE;text-decoration:none\">Kisspeptin</a> for product-specific details.</p>",
