{
    "name": "magpern/universal-multilingual",
    "description": "Multilingual translation layer for WordPress and WooCommerce. One canonical object per content item; translations are presentation overlays stored as stable segments.",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6",
        "yoast/phpunit-polyfills": "^2.0",
        "wp-phpunit/wp-phpunit": "^6.5 || ^7.0",
        "wp-coding-standards/wpcs": "^3.1",
        "woocommerce/woocommerce-sniffs": "^1.0",
        "dealerdirect/phpcodesniffer-composer-installer": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "AIMultilingual\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "AIMultilingual\\Tests\\": "tests/",
            "AIMultilingual\\Quality\\": "tests/quality/src/"
        }
    },
    "scripts": {
        "phpcs": "phpcs",
        "phpcbf": "phpcbf",
        "test:unit": "phpunit -c phpunit.xml.dist",
        "test:integration": "phpunit -c phpunit-integration.xml.dist",
        "quality:validate": "php tests/quality/bin/quality-validate.php",
        "quality:score": "php tests/quality/bin/quality-score.php",
        "quality:compare": "php tests/quality/bin/quality-compare.php",
        "quality:verify-baseline": "php tests/quality/bin/quality-verify-baseline.php"
    },
    "config": {
        "platform": {
            "php": "8.1.99"
        },
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        },
        "sort-packages": true
    }
}
